{
    "name": "gummibeer/gummibeer.de",
    "description": "Website of Gummibeer",
    "license": "MIT",
    "type": "project",
    "keywords": [],
    "authors": [
        {
            "name": "Tom Witkowski",
            "email": "dev@gummibeer.de",
            "homepage": "https://gummibeer.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "astrotomic/laravel-imgix": "^0.1.1",
        "astrotomic/laravel-mime": "^0.4.1",
        "astrotomic/php-open-graph": "^0.5.2",
        "astrotomic/php-twemoji": "^0.1.1",
        "astrotomic/php-unavatar": "^0.3.0",
        "dg/twitter-php": "^4.1.2",
        "guzzlehttp/guzzle": "^7.7.0",
        "laravel/framework": "^12.40",
        "league/commonmark": "^2.7",
        "spatie/emoji": "^2.3.1",
        "spatie/laravel-feed": "^4.5",
        "spatie/laravel-sitemap": "^7.4",
        "statamic/cms": "^6.26"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.6",
        "spatie/laravel-ignition": "^2.9"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "pre-update-cmd": [
            "Statamic\\Console\\Composer\\Scripts::preUpdateCmd"
        ],
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi --no-interaction --quiet"
        ],
        "post-update-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi --no-interaction --quiet",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi --no-interaction",
            "@php artisan statamic:install --ansi --no-interaction"
        ],
        "alex": "alex resources/content/**/*.md",
        "fix": "@php vendor/bin/pint",
        "ide-helper": [
            "@php artisan ide-helper:generate --ansi --no-interaction --quiet",
            "@php artisan ide-helper:meta --ansi --no-interaction --quiet"
        ],
        "og": "@php artisan generate:og:images && yarn dev",
        "route:list": "@php artisan route:list | grep -Ev 'horizon|nova'"
    }
}
