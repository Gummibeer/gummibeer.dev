{
    "name": "statamic/statamic",
    "description": "Statamic",
    "type": "project",
    "keywords": [
        "statamic",
        "cms",
        "flat file",
        "laravel"
    ],
    "require": {
        "php": "^8.3",
        "astrotomic/ecologi-sdk": "^0.3",
        "astrotomic/laravel-github-sponsors": "^1.2",
        "astrotomic/php-open-graph": "^1.0",
        "astrotomic/php-twemoji": "^0.2.4",
        "astrotomic/php-unavatar": "^0.3.0",
        "astrotomic/pixpipe": "^0.1",
        "laravel/framework": "^13.25",
        "laravel/tinker": "^3.0.2",
        "statamic/cms": "^6.27.2",
        "statamic/ssg": "^4.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "fruitcake/laravel-debugbar": "^4.4.1",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.30.5",
        "laravel/sail": "^1.66",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^12.5.33",
        "spatie/laravel-error-solutions": "^1.1"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "pixelfear/composer-dist-plugin": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "pre-update-cmd": [
            "Statamic\\Console\\Composer\\Scripts::preUpdateCmd"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan statamic:install --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\""
        ],
        "build:static": [
            "Composer\\Config::disableProcessTimeout",
            "npm ci --no-audit --no-fund",
            "npm run build",
            "@php artisan config:clear --ansi",
            "@php please stache:refresh --ansi",
            "@php please ssg:generate --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ]
    },
    "$schema": "https://getcomposer.org/schema.json"
}
