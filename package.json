{
    "private": true,
    "type": "module",
    "packageManager": "npm@11.17.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/**/*.{blade.php,css,js}\" \".github/**/*.{yml,yaml}\" \"*.{json,md,yml,yaml}\"",
        "format:check": "prettier --check \"resources/**/*.{blade.php,css,js}\" \".github/**/*.{yml,yaml}\" \"*.{json,md,yml,yaml}\"",
        "lint:prose": "alex 'content/collections/**/*.md'",
        "check": "npm run format:check && npm run build"
    },
    "devDependencies": {
        "@fontsource-variable/fira-code": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource/permanent-marker": "^5.3.0",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@twemoji/api": "^17.0.3",
        "alex": "^11.0.1",
        "alpinejs": "^3.16.3",
        "clipboard": "^2.0.11",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.6",
        "prettier-plugin-blade": "^3.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "prism-themes": "^1.9.0",
        "prismjs": "^1.30.0",
        "tailwindcss": "^4.3.3",
        "vite": "^8.2.2"
    }
}
